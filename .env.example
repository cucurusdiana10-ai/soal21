# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side & Vercel Functions).
GEMINI_API_KEY=""

# VITE_GEMINI_API_KEY: Optional client-side fallback for direct Gemini API calls if backend serverless times out.
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
